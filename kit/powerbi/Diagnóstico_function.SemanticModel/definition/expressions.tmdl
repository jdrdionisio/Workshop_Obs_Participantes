expression GetINEData =
		let
		    GetINEData = (Dim2Code as text, varcd as text, year as text) as table =>
		    let
		        response = Json.Document(Web.Contents("https://www.ine.pt",
		                    [RelativePath = "/ine/json_indicador/pindica.jsp?op=2&varcd=" & varcd & "&Dim1="& year & "&Dim2=" & Dim2Code & "&lang=PT" ])),
		        convertedToTable = Table.FromList(response, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
		        expandedColumn1 = Table.ExpandRecordColumn(convertedToTable, "Column1", {"IndicadorCod", "IndicadorDsg", "MetaInfUrl", "DataExtracao", "DataUltimoAtualizacao", "UltimoPref", "Dados", "Sucesso"}, {"IndicadorCod", "IndicadorDsg", "MetaInfUrl", "DataExtracao", "DataUltimoAtualizacao", "UltimoPref", "Dados", "Sucesso"}),
		        dados = expandedColumn1{0}[Dados],
		        convertedToTable1 = Record.ToTable(dados),
		        expandedValue = Table.ExpandListColumn(convertedToTable1, "Value")
		    in
		        expandedValue
		in
		    GetINEData
	lineageTag: 6e1da0aa-4df9-45dd-8ed3-c5fce6345da4

