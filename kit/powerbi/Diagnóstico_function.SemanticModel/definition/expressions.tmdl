expression GetIPMAData_Site =
		(codigo as text, concelho as text) as table =>
		    let
		        response = Json.Document(Web.Contents("https://api.ipma.pt",
		                    [RelativePath = "/public-data/forecast/aggregate/" & codigo & ".json"])),
		        Table= Table.FromList(response, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
		        Column = Table.ExpandRecordColumn(Table, "Column1", {"tMed", "idTipoTempo", "hR", "dataUpdate", "utci", "ffVento", "globalIdLocal", "probabilidadePrecipita", "idPeriodo", "dataPrev", "ddVento", "tMin", "idFfxVento", "tMax", "iUv", "intervaloHora"}, {"tMed", "idTipoTempo", "hR", "dataUpdate", "utci", "ffVento", "globalIdLocal", "probabilidadePrecipita", "idPeriodo", "dataPrev", "ddVento", "tMin", "idFfxVento", "tMax", "iUv", "intervaloHora"}),
		        Type = Table.TransformColumnTypes(Column,{{"dataPrev", type datetime}, {"dataUpdate", type datetime}}),
		        Replace = Table.ReplaceValue(Type,".",",",Replacer.ReplaceValue,{"tMed", "hR", "utci", "ffVento", "probabilidadePrecipita", "tMin", "idFfxVento", "tMax", "iUv"}),
		        Value = Table.ReplaceValue( Replace,".",",",Replacer.ReplaceText,{"tMed"}),
		        Value1 = Table.ReplaceValue(Value,".",",",Replacer.ReplaceText,{"hR"}),
		        Value2 = Table.ReplaceValue(Value1,".",",",Replacer.ReplaceText,{"utci"}),
		        Value3 = Table.ReplaceValue(Value2,".",",",Replacer.ReplaceText,{"ffVento"}),
		        Value4 = Table.ReplaceValue(Value3,".",",",Replacer.ReplaceText,{"probabilidadePrecipita"}),
		        Value5 = Table.ReplaceValue(Value4,".",",",Replacer.ReplaceText,{"tMin"}),
		        Value6 = Table.ReplaceValue(Value5,".",",",Replacer.ReplaceText,{"tMax"}),
		        Value7 = Table.ReplaceValue(Value6,".",",",Replacer.ReplaceText,{"iUv"}),
		        Type2 = Table.TransformColumnTypes(Value7,{{"iUv", type number}, {"tMax", type number}, {"idFfxVento", type number}, {"tMin", type number}, {"ffVento", type number}, {"utci", type number}, {"hR", type number}, {"tMed", type number}}),
		        filter = Table.SelectRows(Type2, each [tMin] <> null and [tMin] <> "")
		    in
		        filter
	lineageTag: f8a2c94b-8a59-4865-9cec-ddaf86389b63

