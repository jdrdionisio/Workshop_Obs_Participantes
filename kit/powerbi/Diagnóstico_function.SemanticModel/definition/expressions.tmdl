expression GetIPMAClimateData =
		(datasetname as text, datasetcode as text, distrito as text, concquery as text, concelho as text) as table =>
		  let
		  Url = Csv.Document(Web.Contents("https://api.ipma.pt", [RelativePath= "/open-data/observation/climate/" & datasetname & "/"& distrito & datasetcode & concquery])),
		  Initial= Table.PromoteHeaders(Url, [PromoteAllScalars=true]),
		  FinalTable = Table.AddColumn(Initial, "Concelho", each concelho)
		  in
		    FinalTable
	lineageTag: a179f6c2-900f-47b9-95b5-97597bf4838d

