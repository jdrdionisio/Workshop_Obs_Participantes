expression GetAPAData =
		(id as text) as table =>
		  let
		  // Replace 'qualar.apambiente.pt' with the actual base URL if different
		  Today = DateTime.ToText(DateTime.LocalNow(), "yyyy-MM-dd"),
		  // Today's date in YYYY-MM-DD format
		  Url = Json.Document(Web.Contents("https://qualar.apambiente.pt", [RelativePath = "/api/app.php?type=dados&data=" & Today & "&estacao_id=" & id & "&range=d"])),
		    // Today's date in YYYY-MM-DD format
			InitialTable = Table.FromRecords({Url}),
		    TypedTable = Table.TransformColumnTypes(InitialTable, {{"cats", type any}, {"vals", type any}}),
		    ExpandedVals = Table.ExpandListColumn(TypedTable, "vals"),
		    ExpandedColumns = Table.ExpandRecordColumn(ExpandedVals, "vals", {"p", "x", "i", "v"}, {"p", "x", "i", "v"}),
		    ReplacedDecimal = Table.ReplaceValue(ExpandedColumns, ".", ",", Replacer.ReplaceText, {"v"}),
		    NewColumn= Table.AddColumn(ReplacedDecimal, "Indicador", each if [p] = 1 then "Dióxido de Azoto" else if [p] = 2 then "Monóxido de Carbono" else if [p] = 4 then "Partículas 10μg" else if [p] = 0 then "Ozono" else if [p] = 6 then "Benzeno" else if [p] = 5 then "Partículas 2,5μg" else if [p] = 3 then "Dióxido de Enxofre" else null),
		    idTable = Table.AddColumn(NewColumn, "ID", each id),
		    FinalTable = Table.TransformColumnTypes(idTable, {{"v", type number}})
		  in
		    FinalTable
	lineageTag: 1fbbff3c-fd5f-41cf-b037-b45119b302d7

